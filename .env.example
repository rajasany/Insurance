# Leave unset to run the app against the deterministic mock LLM provider.
# Set it to run the agents against Claude.
ANTHROPIC_API_KEY=

# Model used by every agent. Defaults to claude-opus-5.
UNDERWRITING_MODEL=claude-opus-5

# Force the mock provider even when a key is present (useful for eval runs).
UNDERWRITING_LLM=auto   # auto | claude | mock
